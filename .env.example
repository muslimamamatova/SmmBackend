# Образец файла переменных окружения. Скопируйте его в .env и поправьте
# значения под свою машину/сервер — сам .env в git не попадает.
#
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

# --- Безопасность -------------------------------------------------------
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Домены за HTTPS-прокси, которым доверяем при проверке CSRF (через запятую).
# Нужно только в продакшене на своём домене, например:
# CSRF_TRUSTED_ORIGINS=https://smm.example.com
CSRF_TRUSTED_ORIGINS=

# --- База данных ----------------------------------------------------------
# sqlite — ничего дополнительно настраивать не нужно (файл db.sqlite3 в корне).
# postgres — заполните параметры подключения ниже.
DB_ENGINE=sqlite
DB_NAME=smm_marketplace
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- CORS (доступ для внешних клиентов/мобильных приложений) ---------------
CORS_ALLOW_ALL_ORIGINS=True
# Если CORS_ALLOW_ALL_ORIGINS=False, укажите разрешённые источники через запятую:
CORS_ALLOWED_ORIGINS=

# --- Локализация ------------------------------------------------------------
LANGUAGE_CODE=ru-ru
TIME_ZONE=UTC

# --- Почта (коды подтверждения email при регистрации) -----------------------
# Dev-режим по умолчанию: письма печатаются в консоль runserver.
# Для реальной отправки задайте EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# и заполните параметры SMTP ниже.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@smm-marketplace.local
# Сколько минут действует код подтверждения email.
OTP_TTL_MINUTES=10

# --- Логирование --------------------------------------------------------------
# DEBUG/INFO/WARNING/ERROR — уровень логов самого Django и кода проекта.
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- Дополнительная защита (учитывается только при DEBUG=False) ----------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
